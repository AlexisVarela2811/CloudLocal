{
    "name": "CloudLocal",
    "version": "0.1.4",
    "private": true,
    "license": "MIT",
    "engines": {
        "node": ">=22.12.0"
    },
    "description": "Private local file server with web interface",
    "main": "launcher/src/main.cjs",
    "scripts": {
        "start:backend": "npm --workspace cloudlocal-server start",
        "start:frontend": "npm --workspace client run dev",
        "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
        "build:frontend": "npm --workspace client run build",
        "check:docs": "node .scripts/check-links.cjs && node .scripts/check-endpoints.cjs",
        "lint:frontend": "npm --workspace client run lint",
        "preview:frontend": "npm --workspace client run preview",
        "test": "npm run test:server && npm run test:client && npm --prefix launcher test",
        "test:server": "npm --workspace cloudlocal-server test",
        "test:client": "node --test client/test/*.test.mjs",
        "version:patch": "node scripts/version.cjs patch",
        "version:minor": "node scripts/version.cjs minor",
        "version:major": "node scripts/version.cjs major",
        "build:exe": "cd launcher && node scripts/build.cjs",
        "smoke:exe": "node launcher/scripts/smoke.cjs",
        "release:candidate": "node launcher/scripts/release.cjs",
        "release:verify": "node launcher/scripts/release-verify.cjs"
    },
    "workspaces": [
        "client",
        "server"
    ],
    "dependencies": {
        "concurrently": "^9.1.2"
    },
    "type": "module",
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "sharp": "^0.35.5"
    }
}
