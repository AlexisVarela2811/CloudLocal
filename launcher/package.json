{
    "name": "cloudlocal-launcher",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "build": "node scripts/build.cjs",
        "smoke": "node scripts/smoke.cjs",
        "test": "node --test test/*.test.cjs"
    },
    "dependencies": {
        "tray-hook": "^1.1.1"
    },
    "devDependencies": {
        "bonjour-service": "^1.3.0",
        "esbuild": "0.28.2",
        "node-win-x64": "22.23.2",
        "pkg": "^5.8.1",
        "postject": "1.0.0-alpha.6",
        "rcedit": "^5.0.2"
    },
    "pkg": {
        "assets": [
            "../client/dist/**/*"
        ],
        "targets": [
            "node18-win-x64"
        ],
        "outputPath": "dist",
        "options": "no-console"
    }
}